{
  "name": "skrivalnica",
  "version": "1.0.0",
  "private": true,
  "description": "Skrivalnica - 3D večigralska igra skrivanja v predmete za telefon",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite client",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build client",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=server/dist/index.js",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p client/tsconfig.json && tsc -p server/tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "bots": "tsx server/src/bots.ts",
    "icons": "node scripts/gen-icons.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.187.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "puppeteer-core": "^25.18.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.187.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
